{
  "schemaVersion": "1.0",
  "appliance": "dryer",
  "displayName": "Dryer",
  "pointerDimensionsAllowed": false,
  "requiredDimensionIds": [
    "brand",
    "model",
    "price",
    "capacityKg",
    "energyLevel"
  ],
  "defaultListOrder": [
    {
      "dimensionId": "price",
      "direction": "asc"
    },
    {
      "dimensionId": "annualEnergyKwh",
      "direction": "asc"
    }
  ],
  "defaultComparisonDimensionIds": [
    "brand",
    "model",
    "price",
    "capacityKg",
    "energyLevel",
    "heatPumpType",
    "noiseLevelDb"
  ],
  "dimensions": [
    {
      "id": "brand",
      "label": "Brand",
      "type": "string",
      "required": true
    },
    {
      "id": "model",
      "label": "Model",
      "type": "string",
      "required": true
    },
    {
      "id": "price",
      "label": "Price",
      "type": "numeric",
      "unit": "CNY",
      "required": true
    },
    {
      "id": "capacityKg",
      "label": "Capacity",
      "type": "numeric",
      "unit": "kg",
      "required": true
    },
    {
      "id": "energyLevel",
      "label": "Energy Level",
      "type": "enum",
      "allowedValues": [
        "Level 1",
        "Level 2",
        "Level 3",
        "Level 4",
        "Level 5"
      ],
      "required": true
    },
    {
      "id": "heatPumpType",
      "label": "Heat Pump Type",
      "type": "enum",
      "allowedValues": [
        "Heat Pump",
        "Condensing",
        "Ventless",
        "Exhaust"
      ],
      "required": false
    },
    {
      "id": "annualEnergyKwh",
      "label": "Annual Energy",
      "type": "numeric",
      "unit": "kWh",
      "required": false
    },
    {
      "id": "noiseLevelDb",
      "label": "Noise Level",
      "type": "numeric",
      "unit": "dB",
      "required": false
    },
    {
      "id": "hasInverterMotor",
      "label": "Has Inverter Motor",
      "type": "boolean",
      "required": false
    },
    {
      "id": "sourceUrl",
      "label": "Source URL",
      "type": "string",
      "required": false
    },
    {
      "id": "imageUrl",
      "label": "Image URL",
      "type": "string",
      "required": false
    }
  ]
}
