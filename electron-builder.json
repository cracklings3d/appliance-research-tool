{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.applianceresearchtool.app",
  "productName": "ApplianceResearchTool",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*"
  ],
  "extraResources": [
    {
      "from": "schemas",
      "to": "schemas",
      "filter": [
        "*.schema.json"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  }
}
